menu "0067: ESP32-C3 LED matrix HTTP"

config TUTORIAL_0067_MATRIX_PIN_MOSI
    int "MAX7219 DIN (MOSI) GPIO"
    range 0 21
    default 4

config TUTORIAL_0067_MATRIX_PIN_CS
    int "MAX7219 CS GPIO"
    range 0 21
    default 5

config TUTORIAL_0067_MATRIX_PIN_SCK
    int "MAX7219 CLK (SCK) GPIO"
    range 0 21
    default 6

config TUTORIAL_0067_MATRIX_CHAIN_LEN
    int "MAX7219 chain length"
    range 1 16
    default 12

config TUTORIAL_0067_MATRIX_SPI_HZ
    int "MAX7219 SPI clock (Hz)"
    range 1000 10000000
    default 100000

config TUTORIAL_0067_MATRIX_DEFAULT_FPS
    int "Default animation FPS"
    range 1 60
    default 15

config TUTORIAL_0067_HTTP_MAX_BODY
    int "Max HTTP body bytes"
    range 64 4096
    default 512

config TUTORIAL_0067_JS_MEM_BYTES
    int "MicroQuickJS arena bytes"
    range 32768 524288
    default 131072

config TUTORIAL_0067_JS_MAX_BODY
    int "Max JS REST body bytes"
    range 128 16384
    default 4096

config TUTORIAL_0067_JS_EVAL_TIMEOUT_MS
    int "Default JS eval timeout (ms)"
    range 10 5000
    default 250

config TUTORIAL_0067_JS_MAX_TIMERS
    int "Max active JS timers"
    range 4 128
    default 32

endmenu
