menu "PaperS3 WAMR Allocator Control"

choice PAPERS3_WAMR_ALLOCATOR_BACKING
    prompt "WAMR allocator backing"
    default PAPERS3_WAMR_ALLOCATOR_POOL_SPIRAM
    help
        Select how the allocator-control firmware backs WAMR runtime allocations.

config PAPERS3_WAMR_ALLOCATOR_POOL_SPIRAM
    bool "Pool allocator backed by external SPIRAM"

config PAPERS3_WAMR_ALLOCATOR_POOL_INTERNAL
    bool "Pool allocator backed by internal RAM"

config PAPERS3_WAMR_ALLOCATOR_SYSTEM
    bool "System allocator"

endchoice

config PAPERS3_WAMR_COPY_EMBEDDED_TO_INTERNAL_BEFORE_LOAD
    bool "Copy embedded Wasm into internal RAM before load"
    default n
    help
        When enabled, the default embedded-module path copies the embedded Wasm
        bytes into internal RAM before calling wasm_runtime_load(). This exists
        as a mitigation experiment for the PaperS3 flash-mapped embedded-buffer
        contamination issue.

endmenu
