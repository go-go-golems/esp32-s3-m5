+
+bool EPD_Painter::waitIdle(uint32_t timeout_ms) {
+  if (!_initialized.load() || !_paint_active_sem) return false;
+  const TickType_t start = xTaskGetTickCount();
+  const TickType_t timeout = pdMS_TO_TICKS(timeout_ms);
+
+  while (paintStage.load() != 0) {
+    if ((xTaskGetTickCount() - start) >= timeout) return false;
+    vTaskDelay(pdMS_TO_TICKS(1));
+  }
+
+  const TickType_t elapsed = xTaskGetTickCount() - start;
+  const TickType_t remaining = elapsed < timeout ? timeout - elapsed : 0;
+  if (xSemaphoreTake(_paint_active_sem, remaining) != pdTRUE) return false;
+  const bool idle = paintStage.load() == 0;
+  xSemaphoreGive(_paint_active_sem);
+  return idle;
+}
+
+bool EPD_Painter::powerDown(uint32_t timeout_ms) {
+  return PanelPowerGuard::powerDownNow(timeout_ms);
+}
+
+bool EPD_Painter::panelPowerActive() const {
+  return PanelPowerGuard::isPowerActive();
