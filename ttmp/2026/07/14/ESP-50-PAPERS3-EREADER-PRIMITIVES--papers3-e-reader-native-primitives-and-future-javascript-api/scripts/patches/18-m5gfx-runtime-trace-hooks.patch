diff --git a/src/lgfx/v1/platforms/esp32/epd_trace_hooks.hpp b/src/lgfx/v1/platforms/esp32/epd_trace_hooks.hpp
new file mode 100644
index 0000000..43b83b4
--- /dev/null
+++ b/src/lgfx/v1/platforms/esp32/epd_trace_hooks.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "sdkconfig.h"
+
+namespace lgfx {
+inline namespace v1 {
+namespace epd_trace {
+
+enum event_t : uint32_t {
+  app_operation_begin = 1,
+  app_operation_end = 2,
+  display_enqueue = 10,
+  update_dequeue = 11,
+  update_prepared = 12,
+  power_on_begin = 20,
+  power_on_end = 21,
+  frame_begin = 30,
+  frame_end = 31,
+  power_off_begin = 40,
+  power_off_end = 41,
+  display_idle = 50,
+};
+
+#if defined(CONFIG_PAPERS3_M5GFX_RUNTIME_TRACE) && CONFIG_PAPERS3_M5GFX_RUNTIME_TRACE
+extern "C" void lgfx_epd_trace_emit(uint32_t event, uint32_t a, uint32_t b, uint32_t c,
+                                      uint32_t d, uint32_t e) __attribute__((weak));
+
+__attribute__((always_inline)) inline void emit(uint32_t event, uint32_t a = 0, uint32_t b = 0,
+                                                 uint32_t c = 0, uint32_t d = 0, uint32_t e = 0)
+{
+  if (lgfx_epd_trace_emit != nullptr) {
+    lgfx_epd_trace_emit(event, a, b, c, d, e);
+  }
+}
+#define LGFX_EPD_TRACE_EMIT(...) ::lgfx::v1::epd_trace::emit(__VA_ARGS__)
+#define LGFX_EPD_TRACE_COUNTER(name) uint32_t name = 0
+#define LGFX_EPD_TRACE_INCREMENT(name) (++(name))
+#else
+// A macro, rather than an empty inline function, prevents evaluation of trace
+// arguments such as queue-depth queries in the trace-disabled control build.
+#define LGFX_EPD_TRACE_EMIT(...) do { } while (0)
+#define LGFX_EPD_TRACE_COUNTER(name)
+#define LGFX_EPD_TRACE_INCREMENT(name) do { } while (0)
+#endif
+
+}  // namespace epd_trace
+}  // namespace v1
+}  // namespace lgfx
